  Future<void> loadLocation() async {
    try {
      final Position position = await getUserLocation();

      if (!mounted) {
        return;
      }

      if (position.accuracy > 35.0) {
        debugPrint(
          'GPS accuracy too low, skipped: ${position.accuracy}m',
        );
        return;
      }

      final LatLng location = LatLng(
        position.latitude,
        position.longitude,
      );

      setState(() {
        userLocation = location;
        _isFollowingLocation = true;

        if (position.heading >= 0 && position.heading.isFinite) {
          _currentHeading = position.heading;
        }
      });

      WidgetsBinding.instance.addPostFrameCallback((_) {
        if (!mounted || !_isFollowingLocation) {
          return;
        }

        try {
          final currentCenter = mapController.camera.center;
          final distanceMeters = const Distance().as(
            LengthUnit.Meter,
            currentCenter,
            location,
          );

          if (distanceMeters > 20) {
            mapController.move(
              location,
              13.5,
            );
          }
        } catch (e) {
          debugPrint('MAP MOVE ERROR (loadLocation): $e');
        }
      });

      _startPositionTracking();
    } catch (e) {
      if (!mounted) {
        return;
      }

      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text(
            'Konum alınamadı: $e',
          ),
        ),
      );
    }
  }

  // ============================================================
  // KONUM TAKİBİ
  // ============================================================

  void _startPositionTracking() {
    _positionSubscription?.cancel();

    const LocationSettings settings = LocationSettings(
      accuracy: LocationAccuracy.bestForNavigation,
      distanceFilter: 20,
    );

    _positionSubscription = Geolocator.getPositionStream(
      locationSettings: settings,
    ).listen(
      (Position position) {
        if (!mounted) {
          return;
        }

        if (position.accuracy > 35.0) {
          debugPrint(
            'GPS stream skipped (low accuracy): ${position.accuracy}m',
          );
          return;
        }

        final LatLng nextLocation = LatLng(
          position.latitude,
          position.longitude,
        );

        if (userLocation == null) {
          setState(() {
            userLocation = nextLocation;
            _isFollowingLocation = true;
          });

          if (mapController.camera.center != nextLocation) {
            mapController.move(
              nextLocation,
              15.0,
            );
          }
          return;
        }

        final double distMeters = const Distance().as(
          LengthUnit.Meter,
          userLocation!,
          nextLocation,
        );

        if (distMeters < 6.0) {
          return;
        }

        double heading = _currentHeading;

        if (_navigationStarted && routePoints.length >= 2) {
          heading = _routeBearing(nextLocation);
        } else if (position.heading >= 0 &&
            position.heading.isFinite &&
            position.speed >= 0.5) {
          heading = position.heading;
        }

        setState(() {
          userLocation = nextLocation;
          _currentHeading = heading;
        });

        if (_isFollowingLocation) {
          final currentCenter = mapController.camera.center;
          final centerDistanceMeters = const Distance().as(
            LengthUnit.Meter,
            currentCenter,
            nextLocation,
          );

          final now = DateTime.now();

          final bool shouldFollow =
              centerDistanceMeters > 18 ||
              _lastMapFollowAt == null ||
              now.difference(_lastMapFollowAt!) >
                  const Duration(milliseconds: 1200);

          if (shouldFollow) {
            _lastMapFollowAt = now;
            mapController.move(
              nextLocation,
              _navigationStarted ? 15.5 : 14.5,
            );
          }
        }
      },
      onError: (Object error, StackTrace stackTrace) {
        debugPrint('GPS STREAM ERROR: $error');
      },
    );
  }

