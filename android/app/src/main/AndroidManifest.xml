<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sesli komut (speech_to_text) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- İnternet izni olmadan harita, adres arama ve rota hesaplama gibi
         tüm ağ istekleri sessizce başarısız olur. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Konum (uygulama açıkken / navigasyon sırasında) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- Navigasyon sırasında ön plan servisi (kalıcı bildirim) ile konum.
         ACCESS_BACKGROUND_LOCATION GEREKMEZ: servis uygulama öndeyken
         başlatılıyor. Eklemek Play Store'da ek beyan/inceleme gerektirir. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Android 13+: ön plan servisi bildirimini göstermek için -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="lkw_almanya"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <!-- Flutter için gerekli -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- NOT: geolocator, kendi ön plan servisini (foregroundServiceType=
             location) manifest birleştirmesiyle otomatik ekler. Buraya servis
             yazmana gerek yok. -->

    </application>

    <!-- Flutter text processing -->
    <queries>
        <!-- Android 11+ cihazlarda flutter_tts ses motorlarını
             sorgulayabilmek için gereklidir. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
        <!-- Android 11+ cihazlarda speech_to_text konuşma tanıma
             servislerini bulabilmek için gereklidir. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>

</manifest>
